<% pessoas = @pessoas.positive? ? @pessoas : nil %>
<% passos = [
     { numero: 1, rotulo: "Data",
       caminho: reservas_path(data: @data, turno: @turno, pessoas: pessoas) },
     { numero: 2, rotulo: "Harmonização",
       caminho: reservas_harmonizacao_path(data: @data, turno: @turno, pessoas: pessoas,
                                           harmonizacao: params[:harmonizacao], harmonizacoes: @harmonizacoes) },
     { numero: 3, rotulo: "Seus dados",
       caminho: reservas_dados_path(data: @data, turno: @turno, pessoas: pessoas,
                                    harmonizacao: params[:harmonizacao], harmonizacoes: @harmonizacoes) }
   ] %>

<nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-legenda" aria-label="Progresso da reserva">
  <% passos.each_with_index do |passo, indice| %>
    <% atual = passo[:numero] == atual_passo %>

    <% if passo[:numero] < atual_passo %>
      <%= link_to passo[:caminho], class: "text-cinza-texto hover:text-creme transition-colors underline underline-offset-4" do %>
        <%= passo[:numero] %> <%= passo[:rotulo] %>
      <% end %>
    <% else %>
      <span class="<%= atual ? "text-latao" : "text-cinza-texto/60" %>" <%= 'aria-current="step"'.html_safe if atual %>>
        <%= passo[:numero] %> <%= passo[:rotulo] %>
      </span>
    <% end %>

    <% unless indice == passos.size - 1 %>
      <span class="text-cinza-texto/40" aria-hidden="true">·</span>
    <% end %>
  <% end %>
</nav>
