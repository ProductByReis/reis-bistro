<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <% titulo = content_for?(:title) ? yield(:title) : "Reis Bistrô — pizza de autor e cerveja da casa, em Jundiaí" %>
    <% descricao = content_for?(:description) ? yield(:description) : "Menu degustação de seis etapas de pizza autoral, harmonizado com a Reis Beer. Duas estrelas Michelin, doze mesas, de quinta a domingo em Jundiaí." %>

    <title><%= titulo %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= descricao %>">
    <meta name="theme-color" content="#1A1410">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Reis Bistrô">
    <meta name="mobile-web-app-capable" content="yes">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Reis Bistrô">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:title" content="<%= titulo %>">
    <meta property="og:description" content="<%= descricao %>">
    <meta property="og:image" content="<%= image_url("hero.webp") %>">
    <meta name="twitter:card" content="summary_large_image">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,600;1,400&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-carvao text-creme antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-latao focus:text-carvao focus:px-5 focus:py-3 focus:text-legenda focus:uppercase focus:tracking-[0.18em]"
    >
      Ir para o conteúdo
    </a>
    <%= yield %>
  </body>
</html>
