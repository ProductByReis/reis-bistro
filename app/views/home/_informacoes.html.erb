<% endereco = "Rua do Castanho, 412 — Castanho, Jundiaí/SP" %>
<% mapa_url = "https://www.google.com/maps/search/?api=1&query=#{CGI.escape(endereco)}" %>

<section id="contato" class="scroll-mt-24 bg-carvao-claro py-secao xl:py-secao-lg" aria-labelledby="contato-titulo">
  <div class="wrap xl:grid xl:grid-cols-12 xl:gap-16 xl:items-start">
    <div class="xl:col-span-5 revelar" data-controller="revelar">
      <p class="rotulo">Visite</p>
      <h2 id="contato-titulo" class="mt-6 font-display text-h2">Quinta a domingo</h2>

      <dl class="mt-12 space-y-8">
        <div class="border-t border-latao/25 pt-6">
          <dt class="rotulo">Horário</dt>
          <dd class="mt-3 text-corpo text-creme/80">
            Quinta, sexta, sábado e domingo, das 18h à meia-noite. Fechamos de segunda a quarta.
          </dd>
        </div>

        <div class="border-t border-latao/25 pt-6">
          <dt class="rotulo">Endereço</dt>
          <dd class="mt-3 text-corpo text-creme/80">
            <%= endereco %>
            <a href="<%= mapa_url %>" target="_blank" rel="noopener" class="mt-2 block text-legenda text-latao underline underline-offset-4">
              Ver no mapa
            </a>
          </dd>
        </div>

        <div class="border-t border-latao/25 pt-6">
          <dt class="rotulo">Contato</dt>
          <dd class="mt-3 space-y-1 text-corpo text-creme/80">
            <p>
              <a href="tel:+<%= ReservationsHelper::TELEFONE_E164 %>" class="hover:text-creme"><%= ReservationsHelper::TELEFONE %></a>
              <span class="text-cinza-texto">·</span>
              <a href="<%= ReservationsHelper::WHATSAPP %>" target="_blank" rel="noopener" class="text-latao underline underline-offset-4">WhatsApp</a>
            </p>
            <p><a href="mailto:<%= ReservationsHelper::EMAIL %>" class="hover:text-creme"><%= ReservationsHelper::EMAIL %></a></p>
            <p><a href="https://instagram.com/<%= ReservationsHelper::INSTAGRAM %>" target="_blank" rel="noopener" class="hover:text-creme">@<%= ReservationsHelper::INSTAGRAM %></a></p>
          </dd>
        </div>

        <div class="border-t border-latao/25 pt-6">
          <dt class="rotulo">Como funciona a reserva</dt>
          <dd class="mt-3 text-corpo text-creme/80">
            A reserva é feita pelo site, para uma mesa de até quatro pessoas. O menu degustação
            é servido para toda a mesa. Avise-nos de restrições alimentares no momento da reserva.
          </dd>
        </div>
      </dl>
    </div>

    <a
      href="<%= mapa_url %>"
      target="_blank"
      rel="noopener"
      class="group mt-12 block xl:mt-0 xl:col-span-7"
    >
      <div class="flex h-72 flex-col items-center justify-center border border-latao/25 bg-carvao px-8 text-center transition-colors group-hover:border-latao/60 xl:h-[520px]">
        <p class="rotulo">Castanho, Jundiaí</p>
        <p class="mt-6 font-display text-h3">Rua do Castanho, 412</p>
        <p class="mt-4 text-legenda text-cinza-texto">
          Estamos a 10 minutos do centro. Há estacionamento na rua.
        </p>
        <span class="mt-8 text-legenda text-latao underline underline-offset-4">Abrir no Google Maps</span>
      </div>
    </a>
  </div>
</section>
