<section id="menu" class="scroll-mt-24 bg-carvao-claro py-secao xl:py-secao-lg" aria-labelledby="menu-titulo">
  <div class="wrap">
    <div class="text-center revelar" data-controller="revelar">
      <p class="rotulo">O menu</p>
      <h2 id="menu-titulo" class="mt-6 font-display text-h2">Seis etapas</h2>
      <p class="mt-6 text-corpo text-creme/70">
        O menu muda com o que a estação entrega. Este é o percurso de hoje.
      </p>
    </div>

    <ol class="mt-16 xl:mt-24">
      <% etapas_do_menu.each_with_index do |etapa, indice| %>
        <% imagem_a_direita = indice.even? %>
        <li class="border-t border-latao/25 py-10 xl:py-12 revelar" data-controller="revelar">
          <div class="xl:grid xl:grid-cols-12 xl:gap-10 xl:items-center">
            <div class="aspect-[3/2] bg-carvao xl:col-span-4 <%= imagem_a_direita ? "xl:order-2" : "xl:order-1" %>">
              <%= image_tag etapa[:imagem],
                    alt: etapa[:alt],
                    loading: "lazy",
                    class: "size-full object-cover" %>
            </div>

            <div class="mt-6 flex gap-5 xl:mt-0 xl:col-span-8 xl:gap-8 <%= imagem_a_direita ? "xl:order-1" : "xl:order-2" %>">
              <span class="font-display text-[3rem] leading-[0.8] text-latao" aria-hidden="true">
                <%= indice + 1 %>
              </span>
              <div>
                <h3 class="font-display text-h3"><%= etapa[:nome] %></h3>
                <p class="mt-3 text-corpo text-creme/70 max-w-leitura"><%= etapa[:descricao] %></p>
              </div>
            </div>
          </div>
        </li>
      <% end %>
    </ol>

    <div class="mt-16 border-y border-latao/25 py-10 text-center">
      <p class="rotulo">Menu degustação — R$ 390 por pessoa</p>
      <p class="mt-4 text-legenda text-cinza-texto">
        Serviço não incluso. Restrições alimentares podem ser informadas na reserva.
      </p>
    </div>
  </div>
</section>
